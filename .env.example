# ==============================================================================
# LeadFlow AI — Environment Configuration (.env.example)
# Production Architecture: Next.js + MongoDB + Groq AI + Zapier + Twenty CRM
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
INTEGRATION_MODE=live

# Database: MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb://127.0.0.1:27017/leadflow-ai

# Authentication & Session Security (Generate with: openssl rand -base64 32)
AUTH_SECRET=super_secret_jwt_key_leadflow_ai_enterprise_2026_change_in_production
INTEGRATION_ENCRYPTION_KEY=super_secret_encryption_key_32_bytes_leadflow_2026

# Google OAuth 2.0 (Google Cloud Console Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# Optional: If deploying Frontend on Vercel and Backend on Render separately:
# RENDER_BACKEND_URL=https://leadflow-ai.onrender.com

# AI Lead Qualification (Groq Cloud API)
GROQ_API_KEY=gsk_placeholder_key_for_groq_api_qualification
GROQ_MODEL=llama-3.3-70b-versatile

# Zapier Cross-App Automation Webhooks (Catch Hook)
ZAPIER_LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/placeholder/webhook
ZAPIER_STATUS_WEBHOOK_SECRET=leadflow_zapier_secret_callback_token_2026

# Twenty CRM Integration (Workflow Webhook & API)
TWENTY_WORKFLOW_WEBHOOK_URL=https://api.twenty.com/rest/workhooks/placeholder
TWENTY_API_URL=https://api.twenty.com
TWENTY_API_KEY=twenty_api_key_placeholder
TWENTY_WORKSPACE_ID=twenty_workspace_id_placeholder

# Sales Notifications & Gmail Communication
GMAIL_ENABLED=false
SALES_NOTIFICATION_EMAIL=sales@leadflow.ai

# Inbound Webhook Security (For Twenty / External callbacks)
WEBHOOK_SECRET=leadflow_general_inbound_webhook_secret_2026

# Optional Monitoring
NEXT_PUBLIC_ANALYTICS_ENABLED=false
